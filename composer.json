{
    "name": "villermen/toolbox",
    "type": "project",
    "autoload": {
        "psr-4": {
            "Villermen\\Toolbox\\": "src/"
        }
    },
    "require": {
        "php": ">=8.3",
        "league/oauth2-client": "^2.9.1",
        "league/oauth2-google": "^5.0.0",
        "symfony/yaml": "^7.4.20",
        "webmozart/assert": "^2.5.0"
    },
    "require-dev": {
        "symfony/var-dumper": "^7.4.18"
    },
    "config": {
        "platform": {
            "php": "8.3.6"
        },
        "sort-packages": true
    },
    "scripts": {
        "dev-server": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8080 -t public"
        ]
    }
}
